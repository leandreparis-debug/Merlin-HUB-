# URL publique de l'application (obligatoire, valeur par défaut en développement).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Fournisseur de données : "supabase" (défaut, V1) ou "memory" (store en
# mémoire, pour développer en local sans projet Supabase — jamais en
# production, une garde-fou lève une erreur si DATA_PROVIDER=memory en
# NODE_ENV=production).
# DATA_PROVIDER=memory

# Utilisées à partir de l'étape 2 (données et authentification via Supabase).
# Voir docs/SUPABASE-SETUP.md pour la marche à suivre.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
